# Pinned versions for the rented B200 machine. env/remote/setup.sh reads this
# file and nothing else decides a version. One KEY=VALUE per line, exact
# versions only (tests/test_remote_env.py checks that).
#
# Every value was read from the working `warplens` conda env on the development
# machine on 2026-11-23 (`conda list`, `pip freeze`), except micromamba and
# nsight-compute, which that env does not have; their source is noted below.

# --- installer -------------------------------------------------------------
# https://github.com/mamba-org/micromamba-releases, release 2.10.0-0. The
# checksum is the one published next to the binary and was confirmed on
# download.
MICROMAMBA_VERSION=2.10.0-0
MICROMAMBA_SHA256_LINUX_64=701f39c06f8e6a670a0e186c8479b9e5c0502a2f0cda6cef65d83bdd2875e8bd

# --- conda-forge -----------------------------------------------------------
PYTHON=3.12.16
NUMPY=2.5.5
PYYAML=6.0.3
PYTEST=9.2.0
# CUDA_VERSION is the toolkit release (conda's `cuda-version` package); the
# three below are the package builds of that release.
CUDA_VERSION=13.5
CUDA_NVCC=13.5.37
CUDA_CUDART_DEV=13.5.37
CUDA_NVRTC=13.5.37
# Nsight Compute (`ncu`). conda-forge builds one release per toolkit release;
# this is the one whose `cuda-version` requirement is 13.5.
NSIGHT_COMPUTE=2026.4.0.10

# --- PyPI ------------------------------------------------------------------
TRITON=3.9.0
NVIDIA_CUTLASS_DSL=4.8.1
APACHE_TVM_TIRX=0.1.0
CUDA_BINDINGS=13.5.0
# What those four pulled in on the development machine, so pip resolves the
# same set again.
APACHE_TVM_FFI=0.1.16
APACHE_TVM_FFI_ORCJIT=0.1.3
CUDA_PATHFINDER=1.9.1
NVIDIA_CUTLASS_DSL_LIBS_BASE=4.8.1
NVIDIA_CUTLASS_DSL_LIBS_CORE=4.8.1
NVIDIA_CUTLASS_DSL_LIBS_CU12=4.8.1
ML_DTYPES=0.7.0
TYPING_EXTENSIONS=4.15.0
SETUPTOOLS=84.2.1

# --- oldest toolkit setup.sh will fall back to -----------------------------
# When the machine's driver is older than CUDA_VERSION, setup.sh installs the
# toolkit release that matches the driver instead (see RUNBOOK.md). conda-forge
# has cuda-nvcc for 12.8 and later.
CUDA_VERSION_MIN=12.8
