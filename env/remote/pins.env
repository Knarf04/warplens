# Pinned versions for the rented B200 machine. env/remote/setup.sh reads this
# file and nothing else decides a version. One KEY=VALUE per line, exact
# versions only, and one commit, the book's (tests/test_remote_env.py checks that).
#
# Every value was read from the working `warplens` conda env on the development
# machine on 2026-11-23 (`conda list`, `pip freeze`), except micromamba and
# nsight-compute, which that env does not have; their source is noted below.

# --- installer -------------------------------------------------------------
# https://github.com/mamba-org/micromamba-releases, release 2.10.0-0. The
# checksum is the one published next to the binary and was confirmed on
# download.
MICROMAMBA_VERSION=2.10.0-0
MICROMAMBA_SHA256_LINUX_64=701f39c06f8e6a670a0e186c8479b9e5c0502a2f0cda6cef65d83bdd2875e8bd

# --- conda-forge -----------------------------------------------------------
PYTHON=3.12.16
NUMPY=2.5.5
PYYAML=6.0.3
PYTEST=9.2.0
SETUPTOOLS=84.2.1
TYPING_EXTENSIONS=4.16.0
# CUDA_VERSION is the toolkit release (conda's `cuda-version` package); the
# three below are the package builds of that release.
CUDA_VERSION=13.5
CUDA_NVCC=13.5.37
CUDA_CUDART_DEV=13.5.37
CUDA_NVRTC=13.5.37
# Nsight Compute (`ncu`). conda-forge builds one release per toolkit release;
# this is the one whose `cuda-version` requirement is 13.5.
NSIGHT_COMPUTE=2026.4.0.10

# --- PyPI ------------------------------------------------------------------
TRITON=3.9.0
NVIDIA_CUTLASS_DSL=4.8.1
APACHE_TVM_TIRX=0.1.0
CUDA_BINDINGS=13.5.0
# What those four pulled in on the development machine (`pip freeze` with
# PYTHONNOUSERSITE=1, so that packages in ~/.local do not count). A key is PIP_
# and the package name; setup.sh turns each into a pip constraint.
PIP_APACHE_TVM_FFI=0.1.16
PIP_APACHE_TVM_FFI_ORCJIT=0.1.3
PIP_CUDA_PATHFINDER=1.9.1
PIP_ML_DTYPES=0.7.0
PIP_NVIDIA_CUTLASS_DSL_LIBS_BASE=4.8.1
PIP_NVIDIA_CUTLASS_DSL_LIBS_CORE=4.8.1
PIP_NVIDIA_CUTLASS_DSL_LIBS_CU12=4.8.1
PIP_PROTOBUF=7.36.2

# --- oldest toolkit setup.sh will fall back to -----------------------------
# When the machine's driver is older than CUDA_VERSION, setup.sh installs the
# toolkit release that matches the driver instead (see RUNBOOK.md). conda-forge
# has cuda-nvcc for 12.8 and later.
CUDA_VERSION_MIN=12.8

# --- the book --------------------------------------------------------------
# "Modern GPU Programming for MLSys", https://github.com/mlc-ai/modern-gpu-programming-for-mlsys,
# whose GEMM kernels are matrix row RT-08. Not a version but a commit: the one the
# committed prediction (validation/blackwell/predicted/e2e/book_hgemm.txt) and
# tests/test_book.py (COMMIT) were made against, and the one CI checks out
# (tests/test_remote_env.py holds the three together). The book has no license,
# so it is not in this repository: setup.sh clones it at this commit into
# $WARPLENS_REMOTE_HOME/book, and nothing copies it from there.
BOOK_COMMIT=3a24144defa6da03d4ab8a1dfcf513b18007d15f

# --- PyTorch, in a second env --------------------------------------------------
# Only validation/blackwell/e2e/triton_gpu.py needs it: Triton on a real GPU takes
# PyTorch tensors. It is NOT installed into the env above. setup.sh makes a venv on
# top of that env ($WARPLENS_REMOTE_HOME/torch-env) and installs it there, because
# torch requires the CUDA 13.2 wheels (cuda-toolkit 13.2.2), and with those in the
# main env's site-packages cuda-bindings loads NVRTC 13.2 in place of the toolkit's
# 13.5 (measured on the development machine, 2026-11-23: nvrtc=13.5 before,
# nvrtc=13.2 after), which would change the PTX TIRx compiles.
#
# TORCH is the release whose own requirement is `triton~=3.9.0`, i.e. TRITON above:
# torch pins the Triton it was built against, and the simulator's Triton tests ran
# with 3.9.0. PyPI's Linux wheel of 2.15.0 is the CUDA 13.2 build (2.15.0+cu132),
# the only CUDA build of this release; it ran on the development machine's driver
# (580.173.02, CUDA 13.0). A driver of the 12.x series cannot load it, and no
# torch release pairs Triton 3.9.0 with CUDA 12: setup.sh then skips this env
# and the Triton step is reported as skipped.
TORCH=2.15.0
TORCH_CUDA_VERSION=13.2
# What `pip install torch==2.15.0` added on the development machine, as constraints.
TORCH_PIP_CUDA_TOOLKIT=13.2.2
TORCH_PIP_FILELOCK=4.3.1
TORCH_PIP_FSSPEC=2026.9.0
TORCH_PIP_JINJA2=3.1.6
TORCH_PIP_MARKUPSAFE=3.0.4
TORCH_PIP_MPMATH=1.3.0
TORCH_PIP_NETWORKX=3.7
TORCH_PIP_NVIDIA_CUBLAS=13.4.1.3
TORCH_PIP_NVIDIA_CUDA_CCCL=13.3.5.0.6
TORCH_PIP_NVIDIA_CUDA_CUPTI=13.2.86
TORCH_PIP_NVIDIA_CUDA_NVRTC=13.2.86
TORCH_PIP_NVIDIA_CUDA_RUNTIME=13.2.86
TORCH_PIP_NVIDIA_CUDNN_CU13=9.26.0.51
TORCH_PIP_NVIDIA_CUFFT=12.2.0.57
TORCH_PIP_NVIDIA_CUFILE=1.17.1.22
TORCH_PIP_NVIDIA_CUSOLVER=12.2.0.11
TORCH_PIP_NVIDIA_CUSPARSE=12.7.10.12
TORCH_PIP_NVIDIA_CUSPARSELT_CU13=0.8.1
TORCH_PIP_NVIDIA_NCCL_CU13=2.30.7
TORCH_PIP_NVIDIA_NVJITLINK=13.5.37
TORCH_PIP_NVIDIA_NVSHMEM_CU13=3.7.2
TORCH_PIP_NVIDIA_NVTX=13.2.86
TORCH_PIP_SYMPY=1.14.0
